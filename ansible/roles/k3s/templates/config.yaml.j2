# Managed by Ansible: infrastructure k3s role
node-name: {{ inventory_hostname | to_json }}
node-ip: {{ private_ip | to_json }}
{% if ansible_host is defined and ansible_host != private_ip %}
node-external-ip: {{ ansible_host | to_json }}
{% endif %}
flannel-iface: {{ k3s_private_interface | to_json }}
{% if inventory_hostname != k3s_bootstrap_host %}
server: {{ ('https://' ~ k3s_bootstrap_ip ~ ':6443') | to_json }}
token-file: /etc/rancher/k3s/join-token
{% endif %}
{% if k3s_mode == 'server' %}
advertise-address: {{ private_ip | to_json }}
cluster-cidr: {{ k3s_pod_cidr | to_json }}
service-cidr: {{ k3s_service_cidr | to_json }}
cluster-dns: {{ k3s_cluster_dns | to_json }}
cluster-domain: {{ k3s_cluster_domain | to_json }}
flannel-backend: vxlan
etcd-expose-metrics: true
secrets-encryption: true
write-kubeconfig-mode: '0600'
tls-san: {{ ((groups['control_plane'] | map('extract', hostvars) | map(attribute='private_ip') | list) + k3s_extra_tls_sans) | to_json }}
disable: {{ k3s_disabled_components | to_json }}
{% if inventory_hostname == k3s_bootstrap_host %}
cluster-init: true
{% endif %}
{% endif %}
