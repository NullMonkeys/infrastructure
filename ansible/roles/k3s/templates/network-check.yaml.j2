apiVersion: v1
kind: Namespace
metadata:
  name: {{ k3s_network_check_namespace | to_json }}
  labels:
    app.kubernetes.io/managed-by: infrastructure-ansible
---
apiVersion: v1
kind: Service
metadata:
  name: network-check
  namespace: {{ k3s_network_check_namespace | to_json }}
spec:
  selector:
    app: network-check
  ports:
    - port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: network-check
  namespace: {{ k3s_network_check_namespace | to_json }}
spec:
  selector:
    matchLabels:
      app: network-check
  template:
    metadata:
      labels:
        app: network-check
    spec:
      automountServiceAccountToken: false
      tolerations:
        - operator: Exists
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: kubernetes.io/hostname
                    operator: In
                    values: {{ groups['k3s_cluster'] | sort | to_json }}
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        fsGroup: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: http
          image: {{ k3s_network_check_image | to_json }}
          command:
            - sh
            - -ec
            - |
              printf '%s\n' "$NODE_NAME" > /www/index.html
              dd if=/dev/zero bs=1024 count=64 2>/dev/null | tr '\000' x > /www/payload
              exec httpd -f -p 8080 -h /www
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          ports:
            - containerPort: 8080
          readinessProbe:
            httpGet:
              path: /
              port: 8080
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 5m
              memory: 8Mi
            limits:
              cpu: 100m
              memory: 32Mi
          volumeMounts:
            - name: www
              mountPath: /www
      volumes:
        - name: www
          emptyDir: {}
